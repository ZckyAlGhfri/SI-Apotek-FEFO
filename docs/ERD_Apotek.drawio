        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; === SETTING TAMPILAN MODERN ===\nhide circle\nskinparam linetype ortho\nskinparam shadowing false\nskinparam roundcorner 4\nskinparam fontName \&quot;Segoe UI\&quot;, Arial, sans-serif\nskinparam fontSize 11\n\n&#39; Styling Tabel\nskinparam class {\n    BackgroundColor #F8FAFC\n    BorderColor #475569\n    BorderThickness 1.2\n    ArrowColor #2563EB\n    ArrowThickness 1.2\n}\n\n&#39; === ENTITAS DATA ===\n\npackage \&quot;Master Data\&quot; #F1F5F9 {\n    entity \&quot;KATEGORI\&quot; as kategori {\n      * id_kategori : INT &lt;&lt;PK&gt;&gt;\n      --\n      nama_kategori : VARCHAR(50)\n    }\n\n    entity \&quot;OBAT\&quot; as obat {\n      * id_obat : INT &lt;&lt;PK&gt;&gt;\n      --\n      id_kategori : INT &lt;&lt;FK&gt;&gt;\n      kode_obat : VARCHAR(20)\n      nama_obat : VARCHAR(100)\n      bentuk_sediaan : VARCHAR(50)\n      harga_jual : DECIMAL(12,2)\n      stok_minimum_alert : INT\n    }\n\n    entity \&quot;PEMASOK\&quot; as pemasok {\n      * id_pemasok : INT &lt;&lt;PK&gt;&gt;\n      --\n      nama_pemasok : VARCHAR(100)\n      no_telepon : VARCHAR(20)\n      alamat : TEXT\n    }\n}\n\npackage \&quot;Inventaris &amp; FEFO\&quot; #EFF6FF {\n    entity \&quot;BATCH_OBAT\&quot; as batch {\n      * id_batch : INT &lt;&lt;PK&gt;&gt;\n      --\n      id_obat : INT &lt;&lt;FK&gt;&gt;\n      id_pemasok : INT &lt;&lt;FK&gt;&gt;\n      nomor_batch : VARCHAR(50)\n      tanggal_masuk : DATE\n      tanggal_kadaluwarsa : DATE\n      stok_sisa : INT\n      harga_beli : DECIMAL(12,2)\n    }\n}\n\npackage \&quot;Transaksi POS\&quot; #F0FDF4 {\n    entity \&quot;PENGGUNA\&quot; as pengguna {\n      * id_pengguna : INT &lt;&lt;PK&gt;&gt;\n      --\n      username : VARCHAR(50)\n      password_hash : VARCHAR(255)\n      nama_lengkap : VARCHAR(100)\n      peran : VARCHAR(20)\n    }\n\n    entity \&quot;PENJUALAN\&quot; as penjualan {\n      * id_penjualan : INT &lt;&lt;PK&gt;&gt;\n      --\n      id_pengguna : INT &lt;&lt;FK&gt;&gt;\n      no_faktur : VARCHAR(50)\n      tanggal_transaksi : DATETIME\n      total_bayar : DECIMAL(12,2)\n    }\n\n    entity \&quot;DETAIL_PENJUALAN\&quot; as detail {\n      * id_detail : INT &lt;&lt;PK&gt;&gt;\n      --\n      id_penjualan : INT &lt;&lt;FK&gt;&gt;\n      id_batch : INT &lt;&lt;FK&gt;&gt;\n      jumlah : INT\n      harga_satuan : DECIMAL(12,2)\n      subtotal : DECIMAL(12,2)\n    }\n}\n\n&#39; === RELASI &amp; ALUR (TERATUR TANPA POTONGAN GARIS) ===\nkategori ||-down-o{ obat : \&quot;mengelompokkan\&quot;\nobat ||-right-o{ batch : \&quot;memiliki batch\&quot;\npemasok ||-down-o{ batch : \&quot;menyuplai\&quot;\n\npengguna ||-down-o{ penjualan : \&quot;memproses\&quot;\npenjualan ||-down-o{ detail : \&quot;memuat\&quot;\nbatch ||-right-o{ detail : \&quot;alokasi FEFO\&quot;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="IridwTYvCPxPTP_5w_p7-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
